# GEMINI_API_KEY: Required for Gemini AI API calls (handwriting OCR, question paper parsing, and semantic grading).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security & Authentication Secrets:
# Move all sensitive authorization clearance keys and signing secrets to environment variables.
JWT_SECRET=
TEACHER_SECRET_KEY=
ADMIN_SECRET_KEY=

# Internal AI Service Security Key:
# Shared secret token (X-Internal-API-Key) securing backend orchestrator communication with the Python AI microservice.
# Prevents unauthorized users and direct internet traffic from accessing evaluation microservices.
AI_SERVICE_SECRET_KEY=

# AI Microservice Connection URL:
# Target address of the Python FastAPI evaluation microservice (defaults to http://localhost:8000).
AI_SERVICE_URL=

# CORS Configuration:
# Comma-separated list of allowed origins (e.g., https://my-school.edu, http://localhost:3000)
CORS_ORIGIN=

# Default institutional demo credentials (override in production)
DEFAULT_DEMO_STUDENT_PASSWORD=
DEFAULT_DEMO_TEACHER_PASSWORD=
DEFAULT_DEMO_ADMIN_PASSWORD=

